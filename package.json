{
  "name": "dsh-plugin-restart",
  "version": "1.0.0",
  "description": "A Restart button for DeepSeek Harness Settings: replaces the dsh web process serving the page, then reconnects the page by itself.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "settings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenkui-luo/dsh-plugin-restart.git"
  },
  "homepage": "https://github.com/chenkui-luo/dsh-plugin-restart#readme",
  "bugs": {
    "url": "https://github.com/chenkui-luo/dsh-plugin-restart/issues"
  },
  "author": "chenkui-luo",
  "contributors": [
    {
      "name": "DeepSeek",
      "url": "https://github.com/deepseek-ai/deepseek-harness",
      "comment": "For DeepSeek Harness (dsh) — this plugin extends it and is built on its plugin protocol."
    }
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
